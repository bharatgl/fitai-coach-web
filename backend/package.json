{
  "name": "@fitai/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsup",
    "test": "npm run build && node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:e2e:plan": "node --env-file-if-exists=.env --import tsx tests/live-plan.e2e.ts",
    "test:e2e:workout": "node --env-file-if-exists=.env --import tsx tests/live-workout.e2e.ts",
    "exercises:import": "node scripts/import-exercise-library.mjs",
    "agent:provision": "node --env-file-if-exists=.env --import tsx src/scripts/provision-elevenlabs-coach.ts",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fitai/ai": "0.1.0",
    "@fitai/contracts": "0.1.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "fastify": "5.12.1",
    "jose": "6.2.9",
    "mongodb": "6.21.0",
    "pdfkit": "0.19.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pdfkit": "0.17.6",
    "eslint": "9.39.4",
    "tsup": "8.5.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
