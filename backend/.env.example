MONGODB_URI=
MONGODB_DB=
EXERCISE_ASSET_BASE_URL=
API_JWT_SECRET=
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
AI_BASE_URL=
# Legacy Gemini variables remain available for the Gemini Live voice fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Charon
# Production research uses Vertex AI application-default credentials instead of an API key.
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=global
VERTEX_AI_RESEARCH_MODEL=gemini-2.5-flash
RESEARCH_DAILY_LIMIT=20
# Operations dashboard budgets. One normalized credit equals 1,000 estimated text tokens.
OPS_MONTHLY_TOKEN_LIMIT=2000000
OPS_MONTHLY_CREDIT_LIMIT=2000
OPS_TELEMETRY_RETENTION_DAYS=30
RELEASE_VERSION=0.1.0
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional. Defaults to a natural male Indian-English voice that matches the coach avatar.
ELEVENLABS_VOICE_ID=
ELEVENLABS_LLM_MODEL=gemini-2.5-flash
SIMLI_API_KEY=
SIMLI_FACE_ID=
# Optional in local development; required to save user-provided API keys.
# Generate with: openssl rand -base64 32
USER_PROVIDER_CREDENTIALS_KEY=
PORT=4000
NODE_ENV=development
