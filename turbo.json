{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "AI_LOG_FAILURE_EXCERPT",
        "API_JWT_SECRET",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "AUTH_SECRET",
        "AUTH_TRUST_HOST",
        "AUTH_URL",
        "BACKEND_API_URL",
        "GEMINI_API_KEY",
        "GEMINI_MODEL",
        "LOG_LEVEL",
        "LOG_SALT",
        "MONGODB_DB",
        "MONGODB_URI",
        "EXERCISE_ASSET_BASE_URL",
        "NODE_ENV"
      ]
    },
    "@fitai/ai#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
